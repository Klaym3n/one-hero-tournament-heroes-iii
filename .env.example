# --- Aplikacja ---
# Publiczny adres serwisu (bez końcowego ukośnika). Musi zgadzać się z Redirect URI w aplikacji Discord.
APP_URL=http://localhost:3000
# Losowy, długi sekret (min. 32 znaki) – np. `openssl rand -hex 32`
SESSION_SECRET=zmien-mnie-na-dlugi-losowy-ciag-znakow-min-32

# --- Baza danych (PostgreSQL 14+) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/homm3

# --- Discord: aplikacja OAuth2 (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI do dodania w Discord: ${APP_URL}/api/auth/discord/callback

# --- Discord: bot (ta sama aplikacja, zakładka "Bot") ---
DISCORD_BOT_TOKEN=
# ID serwera Discord turnieju
DISCORD_GUILD_ID=
# ID kanału do ogłoszeń rund i powiadomień awaryjnych (gdy gracz ma zablokowane DM)
DISCORD_CHANNEL_ID=
# Stałe zaproszenie na serwer (używane w stopce i gdy nie da się dodać gracza automatycznie)
DISCORD_INVITE_URL=https://discord.gg/xxxxxxx

# --- Pierwszy administrator ---
# Lista Discord ID (oddzielona przecinkami) – te konta dostają rolę Administratora przy logowaniu
ADMIN_DISCORD_IDS=

# --- Tylko development ---
# Włącza logowanie testowe bez Discorda pod /api/auth/dev (NIGDY w produkcji – ignorowane gdy NODE_ENV=production)
DEV_LOGIN=false
